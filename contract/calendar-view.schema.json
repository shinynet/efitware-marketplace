{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "calendar"
    },
    "record": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "completed",
                      "incomplete",
                      "in_progress"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sessionCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "completedSessionCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "summary": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "planned",
                      "in_progress",
                      "completed",
                      "skipped",
                      "abandoned"
                    ]
                  },
                  "programName": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "status"
                ]
              }
            },
            "required": [
              "date",
              "status",
              "sessionCount",
              "completedSessionCount"
            ]
          }
        },
        "agenda": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "planned",
                          "in_progress",
                          "completed",
                          "skipped",
                          "abandoned"
                        ]
                      },
                      "time": {
                        "type": "string"
                      },
                      "scheduleId": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{24}$"
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "status",
                      "time"
                    ]
                  }
                }
              },
              "required": [
                "date",
                "items"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "date",
        "days",
        "agenda"
      ]
    },
    "related": {
      "type": "object",
      "properties": {}
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
