{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "body-metric"
    },
    "record": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "weight",
            "neck",
            "shoulders",
            "chest",
            "waist",
            "hips",
            "biceps",
            "forearms",
            "thighs",
            "calves",
            "body_fat",
            "resting_heart_rate"
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "key",
        "from",
        "to"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "const": "weight"
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "number",
                            "minimum": 0
                          },
                          "unit": {
                            "type": "string",
                            "enum": [
                              "lb",
                              "kg"
                            ]
                          }
                        },
                        "required": [
                          "value",
                          "unit"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "date",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "enum": [
                          "neck",
                          "shoulders",
                          "chest",
                          "waist",
                          "hips",
                          "biceps",
                          "forearms",
                          "thighs",
                          "calves"
                        ]
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "number",
                            "minimum": 0
                          },
                          "unit": {
                            "type": "string",
                            "enum": [
                              "cm",
                              "in"
                            ]
                          }
                        },
                        "required": [
                          "value",
                          "unit"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "date",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "const": "body_fat"
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "number",
                            "minimum": 0
                          },
                          "unit": {
                            "type": "string",
                            "const": "percent"
                          }
                        },
                        "required": [
                          "value",
                          "unit"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "date",
                      "value"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "const": "resting_heart_rate"
                      },
                      "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "value": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "unit": {
                            "type": "string",
                            "const": "bpm"
                          }
                        },
                        "required": [
                          "value",
                          "unit"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "date",
                      "value"
                    ]
                  }
                ]
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "number"
                },
                "limit": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "page",
                "limit",
                "total"
              ]
            }
          },
          "required": [
            "data",
            "meta"
          ]
        }
      },
      "required": [
        "observations"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
