                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "description": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        }
                      },
                      "required": [
                        "id",
                        "description"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "objective",
                  "startDate",
                  "endDate",
                  "milestones"
                ]
              }
            }
