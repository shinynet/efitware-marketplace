                "clientId": {
                  "type": "string"
                }
              },
              "required": [
                "clientId"
              ]
            },
            "feasibility": {
              "type": "string",
              "enum": [
                "reasonable",
                "ambitious",
                "not_credible",
                "insufficient_data"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "changedSummary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "revisionEvidence": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "check_in",
                    "goal_changed",
                    "program_detached",
                    "weekly",
                    "milestone"
                  ]
                },
                "fromVersion": {
                  "type": "number"
                },
                "toVersion": {
                  "type": "number"
                },
                "linkedProgram": {
                  "type": "boolean"
                },
                "replacedCount": {
                  "type": "number"
                },
                "skippedCount": {
                  "type": "number"
                }
              },
              "required": [
                "fromVersion",
                "toVersion",
                "linkedProgram",
                "replacedCount",
                "skippedCount"
              ]
            },
            "createdAt": {
              "type": "string"
