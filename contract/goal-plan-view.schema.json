        "historyMeta": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "page": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "page",
            "limit"
          ]
        },
        "aiPaused": {
          "type": "boolean"
        },
        "today": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "noChangeReviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "check_in",
                  "goal_changed",
                  "program_detached",
                  "weekly",
                  "milestone"
                ]
              },
              "reviewedAt": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "evidenceFacts": {
                "type": "object",
                "properties": {
                  "completedSessions": {
                    "type": "number"
                  },
                  "attributedSessions": {
                    "type": "number"
                  },
                  "prCount": {
                    "type": "number"
                  },
                  "checkInCount": {
                    "type": "number"
                  },
                  "commitmentCount": {
                    "type": "number"
                  }
                },
                "required": [
                  "completedSessions",
                  "attributedSessions",
                  "prCount",
                  "checkInCount",
                  "commitmentCount"
                ]
              }
            },
            "required": [
              "id",
              "reason",
              "reviewedAt",
              "evidence"
            ]
          }
