{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "goal-plan"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "goalId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "managementMode": {
          "type": "string",
          "enum": [
            "coach",
            "manual"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "completed",
            "archived"
          ]
        },
        "createdBy": {
          "type": "string",
          "enum": [
            "coach",
            "user"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^goalplan:1:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "goalId",
        "managementMode",
        "status",
        "createdBy",
        "revision"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "achieved",
                "abandoned"
              ]
            },
            "targetDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "targetMeasure": {
              "type": "string"
            },
            "nextCheckInDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "programIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              }
            }
          },
          "required": [
            "id",
            "name",
            "status",
            "programIds"
          ]
        },
        "activeVersion": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "type": "string",
              "enum": [
                "published",
                "superseded"
              ]
            },
            "authoredBy": {
              "type": "string",
              "enum": [
                "coach",
                "user"
              ]
            },
            "externalMcp": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string"
                }
              },
              "required": [
                "clientId"
              ]
            },
            "feasibility": {
              "type": "string",
              "enum": [
                "reasonable",
                "ambitious",
                "not_credible",
                "insufficient_data"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "changedSummary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "revisionEvidence": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "check_in",
                    "goal_changed",
                    "program_detached",
                    "weekly",
                    "milestone"
                  ]
                },
                "fromVersion": {
                  "type": "number"
                },
                "toVersion": {
                  "type": "number"
                },
                "linkedProgram": {
                  "type": "boolean"
                },
                "replacedCount": {
                  "type": "number"
                },
                "skippedCount": {
                  "type": "number"
                }
              },
              "required": [
                "fromVersion",
                "toVersion",
                "linkedProgram",
                "replacedCount",
                "skippedCount"
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "name": {
                    "type": "string"
                  },
                  "objective": {
                    "type": "string"
                  },
                  "startDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "endDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "programId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "programName": {
                    "type": "string"
                  },
                  "reviewDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "milestones": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "description": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        }
                      },
                      "required": [
                        "id",
                        "description"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "objective",
                  "startDate",
                  "endDate",
                  "milestones"
                ]
              }
            }
          },
          "required": [
            "id",
            "version",
            "state",
            "authoredBy",
            "feasibility",
            "rationale",
            "changedSummary",
            "createdAt",
            "phases"
          ]
        },
        "displayedVersion": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "state": {
              "type": "string",
              "enum": [
                "published",
                "superseded"
              ]
            },
            "authoredBy": {
              "type": "string",
              "enum": [
                "coach",
                "user"
              ]
            },
