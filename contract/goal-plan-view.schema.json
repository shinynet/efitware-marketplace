                  "programId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "programName": {
                    "type": "string"
                  },
                  "reviewDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
