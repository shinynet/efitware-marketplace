    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
