{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "workout-review"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "in_progress",
            "completed",
            "skipped",
            "abandoned"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "status"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "reflections": {
          "type": "object",
          "properties": {
            "workoutId": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            },
            "coach": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "generatedAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "content",
                    "generatedAt"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "external": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "externalMcp": {
                      "type": "object",
                      "properties": {
                        "clientId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "clientId"
                      ]
                    }
                  },
                  "required": [
                    "content",
                    "createdAt",
                    "updatedAt",
                    "externalMcp"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^commentary:1:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "workoutId",
            "coach",
            "external",
            "revision"
          ]
        },
        "decisions": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "current",
                      "historical",
                      "partially_undone",
                      "undone"
                    ]
                  },
                  "source": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "factors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "detail": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ]
                    }
                  },
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "string"
                        },
                        "exerciseId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "summary"
                      ]
                    }
                  },
                  "limitations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "headline",
                  "explanation",
                  "kind",
                  "state",
                  "source",
                  "createdAt",
                  "factors",
                  "changes",
                  "limitations"
                ]
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "limit": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "page",
                "limit",
                "total"
              ]
            }
          },
          "required": [
            "data",
            "meta"
          ]
        }
      },
      "required": [
        "reflections",
        "decisions"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
