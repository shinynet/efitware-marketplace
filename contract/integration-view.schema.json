{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "integration"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "provider": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "device",
            "oauth",
            "file"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "connecting",
            "connected",
            "permission_limited",
            "attention_required",
            "disconnected"
          ]
        },
        "grantedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "lastSuccessfulSyncAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastErrorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "disconnectedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "transport",
        "status",
        "grantedScopes",
        "capabilities",
        "createdAt",
        "updatedAt",
        "lastSuccessfulSyncAt",
        "lastErrorCode",
        "disconnectedAt"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "connectionId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "initial",
                      "manual",
                      "webhook",
                      "reconcile"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "running",
                      "completed",
                      "failed"
                    ]
                  },
                  "counts": {
                    "type": "object",
                    "properties": {
                      "received": {
                        "type": "number"
                      },
                      "unchanged": {
                        "type": "number"
                      },
                      "applied": {
                        "type": "number"
                      },
                      "review": {
                        "type": "number"
                      },
                      "invalid": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "received",
                      "unchanged",
                      "applied",
                      "review",
                      "invalid"
                    ]
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "number"
                        },
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "index",
                        "code"
                      ]
                    }
                  },
                  "startedAt": {
                    "type": "string"
                  },
                  "completedAt": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "connectionId",
                  "trigger",
                  "status",
                  "counts",
                  "errors",
                  "startedAt",
                  "completedAt"
                ]
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "limit": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "page",
                "limit",
                "total"
              ]
            }
          },
          "required": [
            "data",
            "meta"
          ]
        }
      },
      "required": [
        "runs"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
