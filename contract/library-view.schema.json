{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "library"
    },
    "record": {
      "type": "object",
      "properties": {
        "query": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            },
            "show": {
              "type": "string",
              "enum": [
                "all",
                "favorites",
                "custom",
                "hidden"
              ]
            },
            "modality": {
              "type": "string",
              "enum": [
                "resistance",
                "cardio",
                "mobility"
              ]
            },
            "page": {
              "type": "number"
            },
            "limit": {
              "type": "number"
            }
          },
          "required": [
            "show",
            "page",
            "limit"
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "exercises": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "modality": {
                    "type": "string",
                    "enum": [
                      "resistance",
                      "cardio",
                      "mobility"
                    ]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "i18n": {
                    "type": "object",
                    "properties": {
                      "de": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "summary": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "description": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "instructions": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "summary"
                        ]
                      }
                    },
                    "required": [
                      "de"
                    ]
                  },
                  "equipmentRequired": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "primaryMuscles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "isCustom": {
                    "type": "boolean"
                  },
                  "isFavorite": {
                    "type": "boolean"
                  },
                  "isHidden": {
                    "type": "boolean"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "setupInstructions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "formCues": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "commonMistakes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "breathingPattern": {
                    "type": "string"
                  },
                  "safetyNotes": {
                    "type": "string"
                  },
                  "contraindications": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tracksWeight": {
                    "type": "boolean"
                  },
                  "tracksReps": {
                    "type": "boolean"
                  },
                  "tracksTime": {
                    "type": "boolean"
                  },
                  "tracksDistance": {
                    "type": "boolean"
                  },
                  "tracksHr": {
                    "type": "boolean"
                  },
                  "tracksPace": {
                    "type": "boolean"
                  },
                  "tracksCadence": {
                    "type": "boolean"
                  },
                  "tracksPower": {
                    "type": "boolean"
                  },
                  "tracksElevation": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "modality",
                  "archived"
                ]
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "limit": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "page",
                "limit",
                "total"
              ]
            }
          },
          "required": [
            "data",
            "meta"
          ]
        }
      },
      "required": [
        "exercises"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
