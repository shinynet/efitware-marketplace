{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "exercise-progress"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "name": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "i18n": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "name",
        "modality"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "stats": {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "number"
            },
            "prCount": {
              "type": "number"
            },
            "unlockAt": {
              "type": "number"
            },
            "progressionEligible": {
              "type": "boolean"
            },
            "topSet": {
              "type": "object",
              "properties": {
                "weightKg": {
                  "type": "number"
                },
                "reps": {
                  "type": "number"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "weightKg",
                "reps",
                "date"
              ]
            },
            "lastRpe": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "value",
                "date"
              ]
            }
          },
          "required": [
            "sessions",
            "prCount",
            "unlockAt"
          ]
        },
        "progression": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{24}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "i18n": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "modality": {
                    "type": "string"
                  },
                  "bestSetReps": {
                    "type": "number"
                  },
                  "bestSetWeightKg": {
                    "type": "number"
                  },
                  "sessionDates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "series": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "value": {
                          "type": "number"
                        },
                        "isPr": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "date",
                        "value"
                      ]
                    }
                  },
                  "unlocked": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "modality",
                  "bestSetReps",
                  "bestSetWeightKg",
                  "sessionDates",
                  "series",
                  "unlocked"
                ]
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "page": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "limit": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "total",
                "page",
                "limit"
              ]
            },
            "metadata": {
              "type": "object",
              "properties": {
                "range": {
                  "type": "string",
                  "enum": [
                    "4w",
                    "8w",
                    "12w",
                    "1y"
                  ]
                },
                "rangeStart": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "today": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "timezone": {
                  "type": "string"
                },
                "readAt": {
                  "type": "string"
                }
              },
              "required": [
                "range",
                "rangeStart",
                "today",
                "timezone",
                "readAt"
              ]
            }
          },
          "required": [
            "data",
            "meta",
            "metadata"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workoutId": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "workoutTitle": {
                "type": "string"
              },
              "instanceId": {
                "type": "string"
              },
              "exerciseName": {
                "type": "string"
              },
              "modality": {
                "type": "string"
              },
              "sets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "warmup",
                        "working",
                        "dropset",
                        "backoff",
                        "topset",
                        "amrap",
                        "interval",
                        "recovery",
                        "cooldown"
                      ]
                    },
                    "completed": {
                      "type": "boolean"
                    },
                    "comments": {
                      "type": "string"
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0
                    },
                    "reps": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "distance": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedWeight": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedDuration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedDistance": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedReps": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    },
                    "restTarget": {
                      "type": "number",
                      "minimum": 0
                    },
                    "rirTarget": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedAmrap": {
                      "type": "boolean"
                    },
                    "plannedRpe": {
                      "type": "number",
                      "minimum": 0
                    },
                    "tempo": {
                      "type": "string"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "left",
                        "right",
                        "both"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "category",
                    "completed"
                  ]
                }
              }
            },
            "required": [
              "workoutId",
              "date",
              "workoutTitle",
              "instanceId",
              "exerciseName",
              "modality",
              "sets"
            ]
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workoutId": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "exerciseId": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "exerciseName": {
                "type": "string"
              },
              "instanceId": {
                "type": "string"
              },
              "setId": {
                "type": "string"
              },
              "modality": {
                "type": "string"
              },
              "weightKg": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reps": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "weight",
                        "oneRm",
                        "volume"
                      ]
                    },
                    "weight": {
                      "type": "number"
                    },
                    "reps": {
                      "type": "number"
                    },
                    "first": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "weight"
                  ]
                }
              }
            },
            "required": [
              "workoutId",
              "date",
              "exerciseId",
              "exerciseName",
              "instanceId",
              "setId",
              "modality",
              "weightKg",
              "reps",
              "prs"
            ]
          }
        },
        "collection": {
          "type": "string",
          "enum": [
            "history",
            "records"
          ]
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stats",
        "progression",
        "history",
        "records",
        "collection",
        "page",
        "limit"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
