{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "schedule"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "name": {
          "type": "string"
        },
        "templateId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "templateName": {
          "type": "string"
        },
        "recurrence": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "programId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "programName": {
          "type": "string"
        },
        "nextOccurrence": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^schedule:1:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "name",
        "templateId",
        "recurrence",
        "startDate",
        "endDate",
        "enabled",
        "revision"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "today": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "today"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin",
        "timeZone"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
