{
  "name": "efitware-marketplace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "vite build --config apps/workout/vite.config.ts && node scripts/generate-contract.ts",
    "typecheck": "vue-tsc --noEmit -p apps/workout/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "lint": "eslint .",
    "release:build": "node scripts/build-release.ts"
  },
  "devDependencies": {
    "zod": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.8",
    "vitest": "4.1.10",
    "eslint": "10.8.0",
    "ajv": "8.20.0",
    "vue": "3.5.40",
    "vue-i18n": "11.4.10",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "vite": "8.1.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@tailwindcss/vite": "4.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "postcss": "8.5.23",
    "@types/node": "26.1.1",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "eslint-plugin-vue": "10.9.2",
    "vue-eslint-parser": "10.4.1"
  }
}
